# Copy this file to .env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
SANITY_API_TOKEN=

# Resend (email)
RESEND_API_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Analytics (production only)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Site URL (used for password reset emails)
NEXT_PUBLIC_SITE_URL=https://trip2bangladesh.com

# Claude AI (server-side only — never expose to client)
ANTHROPIC_API_KEY=

# Cron secret — shared by Vercel Cron and the GitHub Actions keep-alive
# workflow to authenticate to /api/cron/keep-alive. Vercel sets this
# automatically as the Authorization header for its own Cron Jobs when
# CRON_SECRET is set in the project's env vars; the GitHub Actions workflow
# needs the same value stored as a repo secret of the same name.
CRON_SECRET=
